{
  "name": "supportops-admin",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@supportops/api",
    "dev:web": "turbo run dev --filter=@supportops/web",
    "dev:worker": "turbo run dev --filter=@supportops/worker",
    "dev:theme": "turbo run dev --filter=@supportops/ui-theme",
    "dev:form": "turbo run dev --filter=@supportops/ui-form",
    "dev:portfolio": "turbo run dev --filter=@supportops/portfolio",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@supportops/api",
    "build:web": "turbo run build --filter=@supportops/web",
    "build:worker": "turbo run build --filter=@supportops/worker",
    "build:portfolio": "turbo run build --filter=@supportops/portfolio",
    "typecheck": "turbo run typecheck",
    "typecheck:api": "turbo run typecheck --filter=@supportops/api",
    "typecheck:web": "turbo run typecheck --filter=@supportops/web",
    "typecheck:worker": "turbo run typecheck --filter=@supportops/worker",
    "typecheck:portfolio": "turbo run typecheck --filter=@supportops/portfolio",
    "clean": "pnpm -r exec rm -rf dist .turbo .next && rm -rf .turbo",
    "clean:all": "pnpm clean && rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint --filter=@supportops/api --filter=@supportops/worker --filter=@supportops/types --filter=@supportops/ui --filter=@supportops/web --filter=@supportops/portfolio",
    "preflight:push": "pnpm lint && pnpm typecheck && pnpm audit --audit-level=high",
    "lint:fix": "pnpm -r lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "prepare": "husky install",
    "commit": "pnpm exec cz",
    "ac": "git add -A && pnpm run commit && git push",
    "commit:auto": "git add -A && git commit -m \"chore(auto): $(date +%Y%m%d%H%M%S%N | cut -c1-16)\" && git push",
    "ac:auto": "pnpm run commit:auto"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {
    "overrides": {
      "effect": "^3.20.0",
      "flatted": "^3.4.2",
      "immutable": "3.8.3",
      "minimatch@^3.0.0": "3.1.4",
      "minimatch@^9.0.0": "9.0.7",
      "rollup": "^4.59.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@remixicon/react": "^4.6.0",
    "@swc/helpers": "^0.5.17",
    "next": "16.1.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@eslint/js": "^9.39.2",
    "@pnpm/list": "^1000.2.5",
    "@supportops/eslint-config": "workspace:*",
    "@supportops/tsconfig": "workspace:*",
    "commitizen": "^4.2.5",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.0",
    "tsup": "^8.5.1",
    "turbo": "^2.8.20",
    "typescript": "^5",
    "typescript-eslint": "^8.54.0",
    "yaml": "^2.4.2"
  }
}
