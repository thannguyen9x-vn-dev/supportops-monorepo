{
  "name": "supportops-admin",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @supportops/api dev",
    "dev:web": "pnpm --filter @supportops/web dev",
    "dev:worker": "pnpm --filter @supportops/worker dev",
    "dev:theme": "pnpm --filter @supportops/ui-theme dev",
    "dev:form": "pnpm --filter @supportops/ui-form dev",
    "build": "pnpm build:types && pnpm build:packages",
    "build:api": "pnpm --filter @supportops/api build",
    "build:types": "tsc -b",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "build:web": "pnpm --filter @supportops/web build",
    "build:worker": "pnpm --filter @supportops/worker build",
    "typecheck": "tsc -b",
    "typecheck:api": "pnpm --filter @supportops/api typecheck",
    "typecheck:web": "pnpm --filter @supportops/web typecheck",
    "typecheck:worker": "pnpm --filter @supportops/worker typecheck",
    "typecheck:watch": "tsc -b -w",
    "clean": "pnpm -r exec rm -rf dist .turbo .next",
    "clean:types": "tsc -b --clean",
    "clean:all": "pnpm clean && pnpm clean:types && rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "lint": "pnpm -r lint",
    "lint:ci": "pnpm --filter @supportops/api exec eslint \"src/**/*.ts\" --max-warnings=0 && pnpm --filter @supportops/worker exec eslint \"src/**/*.{js,ts}\" --max-warnings=0 && pnpm --filter @supportops/types exec eslint \"src/**/*.ts\" --max-warnings=0 && pnpm --filter @supportops/ui exec eslint . --max-warnings=0 && pnpm --filter @supportops/web exec eslint . --max-warnings=0",
    "lint:fix": "pnpm -r lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "prepare": "husky install",
    "commit": "pnpm exec cz",
    "ac": "git add -A && pnpm run commit && git push",
    "commit:auto": "git add -A && git commit -m \"chore(auto): $(date +%Y%m%d%H%M%S%N | cut -c1-16)\" && git push",
    "ac:auto": "pnpm run commit:auto"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@remixicon/react": "^4.6.0",
    "@swc/helpers": "^0.5.17",
    "next": "16.1.6"
  },
  "devDependencies": {
    "@supportops/eslint-config": "workspace:*",
    "@supportops/tsconfig": "workspace:*",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@eslint/js": "^9.39.2",
    "@pnpm/list": "^1000.2.5",
    "commitizen": "^4.2.5",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "typescript-eslint": "^8.54.0",
    "yaml": "^2.4.2"
  }
}
