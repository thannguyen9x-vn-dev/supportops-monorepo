# AI Provider API Keys — keep these only in AI Service env, never in DB or FE
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Database (read-only connection to the same Postgres instance as NestJS API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supportops

# Service config
PORT=8000
LOG_LEVEL=info
