{
  "extends": "../../packages/tsconfig/nextjs.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@supportops/types": ["../../packages/types/dist"],
      "@supportops/ui": ["../../packages/ui/dist"],
      "@supportops/ui-theme": ["../../packages/ui/theme/dist"],
      "@supportops/ui-form": ["../../packages/ui/form/dist"],
      "@supportops/ui-avatar": ["../../packages/ui/avatar/dist"],
      "@supportops/ui-file-upload": ["../../packages/ui/file-upload/dist"]
    }
  },
  "include": ["next-env.d.ts", "src"],
  "references": [
    { "path": "../../packages/ui/theme" },
    { "path": "../../packages/ui/form" }
  ]
}
