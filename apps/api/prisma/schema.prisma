generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  TRIAGE
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
  WAITING_EXTERNAL_VENDOR
  REOPENED
  CANCELLED
}

enum NotificationEventType {
  REQUEST_CREATED
  REQUEST_ASSIGNED
  REQUEST_STATUS_CHANGED
  REQUEST_COMMENTED
  REQUEST_MENTIONED
  SLA_NEAR_BREACH_RESPONSE
  SLA_NEAR_BREACH_RESOLUTION
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum KnowledgeBaseStatus {
  DRAFT
  PUBLISHED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestImpactLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SourceChannel {
  WEB
  EMAIL
  PHONE
  CHAT
  API
}

enum RequestActivityType {
  REQUEST_CREATED
  STATUS_CHANGED
  ASSIGNED
  REASSIGNED
  COMMENT_ADDED
  INTERNAL_NOTE_ADDED
  SLA_WARNING
  SLA_BREACHED
  RESOLUTION_SUBMITTED
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum SlaType {
  ASSIGNMENT
  RESOLUTION
}

enum SlaHealth {
  ON_TRACK
  AT_RISK
  BREACHED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

model Tenant {
  id                         String                   @id @default(uuid())
  name                       String
  slug                       String                   @unique
  status                     TenantStatus             @default(ACTIVE)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  users                      User[]
  memberships                Membership[]
  invites                    Invite[]
  refreshSessions            RefreshSession[]
  userPreferences            UserPreference[]
  uploadedFiles              UploadedFile[]
  serviceTypes               ServiceType[]
  slaPolicies                SlaPolicy[]
  workflowTransitions        WorkflowTransition[]
  serviceRequests            ServiceRequest[]
  requestActivities          RequestActivity[]
  requestComments            RequestComment[]
  requestAttachments         RequestAttachment[]
  requestWorkLogs            WorkLog[]
  requestSlaRecords          SlaRecord[]
  requestAssignmentHistories AssignmentHistory[]
  requestQueues              RequestQueue[]
  auditLogs                  AuditLog[]
  requestSequences           RequestSequence[]
  assetTypes                 AssetType[]
  assets                     Asset[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  watchers                   RequestWatcher[]
  knowledgeArticles          KnowledgeArticle[]
  cannedResponses            CannedResponse[]

  @@index([status])
}

model User {
  id                         String                   @id @default(uuid())
  tenantId                   String
  email                      String
  fullName                   String?
  isEmailVerified            Boolean                  @default(false)
  emailVerifiedAt            DateTime?
  passwordHash               String
  avatarUrl                  String?
  firstName                  String
  lastName                   String
  phone                      String?
  birthday                   DateTime?
  address                    String?
  city                       String?
  zipCode                    String?
  country                    String?
  organization               String?
  department                 String?
  role                       Role                     @default(MEMBER)
  timezone                   String                   @default("UTC")
  locale                     String                   @default("en")
  status                     UserStatus               @default(PENDING)
  isActive                   Boolean                  @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  tenant                     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships                Membership[]
  invitedMemberships         Membership[]             @relation("MembershipInvitedBy")
  invitesSent                Invite[]                 @relation("InviteSentBy")
  refreshSessions            RefreshSession[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  passwordResetOtps          PasswordResetOtp[]
  emailVerificationTokens    EmailVerificationToken[]
  preference                 UserPreference?
  uploadedFiles              UploadedFile[]           @relation("UploadedFileUploader")
  createdRequests            ServiceRequest[]         @relation("ServiceRequestRequester")
  assignedRequests           ServiceRequest[]         @relation("ServiceRequestAssignee")
  requestActivities          RequestActivity[]        @relation("RequestActivityActor")
  requestComments            RequestComment[]         @relation("RequestCommentAuthor")
  requestWorkLogs            WorkLog[]                @relation("WorkLogAuthor")
  assignmentHistoryFrom      AssignmentHistory[]      @relation("AssignmentFrom")
  assignmentHistoryTo        AssignmentHistory[]      @relation("AssignmentTo")
  assignmentHistoryChangedBy AssignmentHistory[]      @relation("AssignmentChangedBy")
  auditLogs                  AuditLog[]               @relation("AuditLogActor")
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  watchedRequests            RequestWatcher[]
  knowledgeArticles          KnowledgeArticle[]

  @@unique([tenantId, email], name: "tenantId_email")
  @@index([email])
  @@index([status])
  @@index([tenantId])
}

model Membership {
  id              String           @id @default(uuid())
  tenantId        String
  userId          String
  roleCode        String
  status          MembershipStatus @default(INVITED)
  invitedAt       DateTime?
  joinedAt        DateTime?
  invitedById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            AuthRole         @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  invitedBy       User?            @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  refreshSessions RefreshSession[]

  @@unique([tenantId, userId], name: "tenantId_userId")
  @@index([tenantId, status])
  @@index([tenantId, roleCode])
  @@index([userId, status])
}

model AuthRole {
  code            String               @id
  name            String
  description     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  memberships     Membership[]
  rolePermissions AuthRolePermission[]
  invites         Invite[]
}

model AuthPermission {
  code            String               @id
  description     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rolePermissions AuthRolePermission[]
}

model AuthRolePermission {
  roleCode       String
  permissionCode String
  createdAt      DateTime       @default(now())
  role           AuthRole       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission     AuthPermission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@index([permissionCode])
}

model RefreshSession {
  id                  String     @id @default(uuid())
  tenantId            String
  userId              String
  membershipId        String
  tokenHash           String     @unique
  tokenFamilyId       String
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedReason       String?
  replacedBySessionId String?
  lastUsedAt          DateTime?
  createdAt           DateTime   @default(now())
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership          Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([membershipId, revokedAt])
  @@index([tokenFamilyId])
  @@index([tenantId, userId])
}

model Invite {
  id              String    @id @default(uuid())
  tenantId        String
  email           String
  roleCode        String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role            AuthRole  @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  invitedBy       User      @relation("InviteSentBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, email, acceptedAt])
  @@index([tenantId, expiresAt])
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  tenantId             String
  assignmentAlerts     Boolean  @default(true)
  statusUpdateAlerts   Boolean  @default(true)
  slaRiskAlerts        Boolean  @default(false)
  escalationAlerts     Boolean  @default(true)
  resolutionReminders  Boolean  @default(true)
  requestUpdateDigest  Boolean  @default(true)
  commentNotifications Boolean  @default(true)
  mentionNotifications Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model UploadedFile {
  id                 String              @id @default(uuid())
  tenantId           String
  uploadedById       String
  fileName           String
  fileUrl            String
  mimeType           String
  sizeBytes          Int
  createdAt          DateTime            @default(now())
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy         User                @relation("UploadedFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  requestAttachments RequestAttachment[]

  @@index([tenantId, uploadedById, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetOtp {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model ServiceType {
  id          String           @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests    ServiceRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model SlaPolicy {
  id                         String   @id @default(uuid())
  tenantId                   String
  serviceTypeCode            String
  responseMinutes            Int
  resolutionMinutes          Int
  escalationAfterMinutes     Int
  nearBreachThresholdMinutes Int      @default(30)
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceTypeCode])
  @@index([tenantId, isActive])
}

model WorkflowTransition {
  id              String        @id @default(uuid())
  tenantId        String
  serviceTypeCode String
  fromStatus      RequestStatus
  toStatus        RequestStatus
  allowedRoles    String[]
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, serviceTypeCode, isActive])
  @@index([tenantId, fromStatus, toStatus])
}

model RequestQueue {
  tenantId    String
  id          String
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests    ServiceRequest[]

  @@id([tenantId, id])
  @@index([tenantId, isActive])
}

model ServiceRequest {
  id                String              @id @default(uuid())
  tenantId          String
  requestCode       String?
  title             String
  description       String
  serviceTypeId     String
  status            RequestStatus       @default(DRAFT)
  priority          RequestPriority     @default(MEDIUM)
  impactLevel       RequestImpactLevel  @default(MEDIUM)
  urgency           RequestUrgency      @default(MEDIUM)
  locationId        String
  assetId           String?
  requesterId       String
  assigneeId        String?
  queueId           String?
  sourceChannel     SourceChannel       @default(WEB)
  isInternalOnly    Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  submittedAt       DateTime?
  assignedAt        DateTime?
  startedAt         DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceType       ServiceType         @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  requester         User                @relation("ServiceRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee          User?               @relation("ServiceRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  queue             RequestQueue?       @relation(fields: [tenantId, queueId], references: [tenantId, id], onDelete: Restrict)
  asset             Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  activities        RequestActivity[]
  comments          RequestComment[]
  attachments       RequestAttachment[]
  workLogs          WorkLog[]
  slaRecords        SlaRecord[]
  assignmentHistory AssignmentHistory[]
  auditLogs         AuditLog[]
  watchers          RequestWatcher[]

  @@unique([tenantId, requestCode])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, priority])
  @@index([tenantId, updatedAt])
  @@index([tenantId, serviceTypeId])
  @@index([tenantId, requesterId])
  @@index([tenantId, queueId])
}

model RequestActivity {
  id          String              @id @default(uuid())
  tenantId    String
  requestId   String
  type        RequestActivityType
  title       String
  description String?
  actorId     String?
  actorRole   Role?
  metadata    Json?
  createdAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request     ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor       User?               @relation("RequestActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, requestId, createdAt])
}

model RequestComment {
  id         String            @id @default(uuid())
  tenantId   String
  requestId  String
  authorId   String
  visibility CommentVisibility @default(PUBLIC)
  body       String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request    ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author     User              @relation("RequestCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId, requestId, createdAt])
}

model RequestAttachment {
  id             String         @id @default(uuid())
  tenantId       String
  requestId      String
  uploadedFileId String
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedFile   UploadedFile   @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)

  @@index([tenantId, requestId, createdAt])
}

model WorkLog {
  id           String         @id @default(uuid())
  tenantId     String
  requestId    String
  authorId     String
  content      String
  minutesSpent Int?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User           @relation("WorkLogAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId, requestId, createdAt])
}

model SlaRecord {
  id                   String         @id @default(uuid())
  tenantId             String
  requestId            String
  type                 SlaType
  health               SlaHealth      @default(ON_TRACK)
  targetAt             DateTime
  breachedAt           DateTime?
  pausedAt             DateTime?
  resumedAt            DateTime?
  totalPausedSeconds   Int            @default(0)
  nearBreachNotifiedAt DateTime?
  lastCalculatedAt     DateTime?
  isBreached           Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request              ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId, requestId, type])
}

model Notification {
  id        String                @id @default(uuid())
  tenantId  String
  userId    String
  type      NotificationEventType
  title     String
  body      String
  requestId String?
  actorId   String?
  metadata  Json?
  isRead    Boolean               @default(false)
  readAt    DateTime?
  createdAt DateTime              @default(now())
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead, createdAt])
  @@index([tenantId, requestId])
}

model NotificationPreference {
  id        String                @id @default(uuid())
  tenantId  String
  userId    String
  eventType NotificationEventType
  inApp     Boolean               @default(true)
  email     Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@index([tenantId, userId])
}

model RequestWatcher {
  id        String         @id @default(uuid())
  tenantId  String
  requestId String
  userId    String
  autoWatch Boolean        @default(false)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([tenantId, requestId])
  @@index([tenantId, userId])
}

model KnowledgeArticle {
  id        String              @id @default(uuid())
  tenantId  String
  title     String
  body      String
  category  String?
  tags      String[]
  status    KnowledgeBaseStatus @default(DRAFT)
  authorId  String
  isDeleted Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author    User                @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, isDeleted])
  @@index([tenantId, category])
}

model CannedResponse {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  body      String
  category  String?
  tags      String[]
  shortcut  String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@index([tenantId, isDeleted])
}

model AssignmentHistory {
  id             String         @id @default(uuid())
  tenantId       String
  requestId      String
  fromAssigneeId String?
  toAssigneeId   String?
  changedById    String
  reason         String?
  changedAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromAssignee   User?          @relation("AssignmentFrom", fields: [fromAssigneeId], references: [id], onDelete: SetNull)
  toAssignee     User?          @relation("AssignmentTo", fields: [toAssigneeId], references: [id], onDelete: SetNull)
  changedBy      User           @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([tenantId, requestId, changedAt])
}

model AuditLog {
  id         String          @id @default(uuid())
  tenantId   String
  requestId  String?
  entityType String
  entityId   String
  action     String
  actorId    String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime        @default(now())
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request    ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actor      User?           @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, requestId, createdAt])
}

model RequestSequence {
  tenantId   String
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, year])
}

model AssetType {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets      Asset[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Asset {
  id                 String           @id @default(uuid())
  tenantId           String
  assetCode          String
  name               String
  assetTypeId        String
  locationId         String
  status             AssetStatus      @default(ACTIVE)
  serialNumber       String?
  model              String?
  assignedDepartment String?
  responsibleTeam    String?
  installedAt        DateTime?
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetType          AssetType        @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  requests           ServiceRequest[]

  @@unique([tenantId, assetCode])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assetTypeId])
}
