APP_DOMAIN=staging-app.example.com
API_DOMAIN=staging-api.example.com
APP_ORIGIN=https://staging-app.example.com
API_ORIGIN=https://staging-api.example.com

POSTGRES_DB=supportops_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me-min-32-characters
FILE_SIGNING_SECRET=change-me-file-signing-secret

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

MAIL_ENABLED=false
MAIL_PROVIDER=resend
MAIL_DAILY_LIMIT=30
MAIL_FROM_EMAIL=onboarding@resend.dev
MAIL_FROM_NAME=SupportOps Staging
RESEND_API_KEY=

WEB_IMAGE=ghcr.io/your-org/supportops-web:staging
API_IMAGE=ghcr.io/your-org/supportops-api:staging
