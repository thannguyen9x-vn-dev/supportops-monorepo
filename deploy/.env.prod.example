APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
APP_ORIGIN=https://app.example.com
API_ORIGIN=https://api.example.com

POSTGRES_DB=supportops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me-min-32-characters
FILE_SIGNING_SECRET=change-me-file-signing-secret

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

MAIL_ENABLED=false
MAIL_PROVIDER=resend
MAIL_DAILY_LIMIT=90
MAIL_FROM_EMAIL=onboarding@resend.dev
MAIL_FROM_NAME=SupportOps
RESEND_API_KEY=

WEB_IMAGE=ghcr.io/your-org/supportops-web:local
API_IMAGE=ghcr.io/your-org/supportops-api:local
